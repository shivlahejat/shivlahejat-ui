{
  "name": "zerostyled",
  "version": "0.1.0",
  "description": "styled-components DX for Next.js App Router. Works in Server Components. Zero setup: no registry, no compiler, no \"use client\".",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "npm test && npm run typecheck"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "jsdom": "^30.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "css-in-js",
    "styled",
    "nextjs",
    "react-server-components",
    "app-router",
    "zero-config"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-name/zerostyled-ui.git",
    "directory": "packages/zerostyled"
  },
  "engines": {
    "node": ">=18"
  }
}
